    "interfaces": {
      "actions": "Three normalized absolute joint-position targets in [-1, 1], mapped to base_yaw, shoulder, and elbow actuator control ranges every 0.02 s. The applied normalized command is limited to 0.03 per axis from the current normalized joint position before MuJoCo advances ten 0.002 s physics steps.",
      "observations": "Actor state has sin/cos(base yaw), shoulder and elbow angles, three joint velocities scaled by 0.1 and clipped to [-5, 5], world-frame target-minus-ee_site XYZ, and the previous applied command (13 values). The critic additionally receives ee_site XYZ, target XYZ, distance, and forbidden-collision state (21 values). These are simulator-state observations, not a hardware sensor contract."
    },
    "kind": "simrig.task-contract",
    "name": "orbit-arm-sustained-reach",
    "outcomes": {
      "failure": "Invalid or non-finite simulator/policy state has highest precedence, followed by forbidden contact, then failure to sustain the target tolerance before the 200-tick timeout. The expected base-floor support contact is not a failure.",
      "failure_taxonomy": [
        "evaluator_error",
        "invalid_state",
        "forbidden_contact",
        "safety_violation",
        "timeout",
        "task_failure",
        "incomplete",
        "unknown",
        "success"
      ],
      "success": "Independent native MuJoCo measures ee_site world-frame Euclidean distance strictly below 0.05 m for at least five consecutive post-step control ticks, with zero forbidden arm-floor or arm-base contacts, zero MuJoCo warnings, and completion within 200 ticks / 4.0 s."
    },
    "reset": {
      "native": "Evaluation uses the same seeded joint reset, then replaces the sampled goal with the deterministic displayed or held-out target assigned to that case. Policy preview preserves the current arm state when moving to the next displayed target; browser Reset restores the original seeded state and target 1.",
      "training": "Zero joint velocity; base yaw uniform in [-pi, pi], shoulder uniform in [-1.2, -0.5] rad, elbow uniform in [0.8, 1.8] rad. Target angle is continuous uniform in [-pi, pi], radius in [0.22, 0.32] m, and world height in [0.08, 0.24] m."
    },
    "scene": {
      "allowed_contacts": [
        "floor with base"
      ],
      "assumptions": [
        "The orbit_arm.xml shoulder is at world z=0.10 m and the two links total 0.38 m. Audited targets are 0.234-0.335 m from the shoulder and exactly reachable by the elbow-up IK control.",
        "The target marker has contacts disabled. The expected floor-base support contact is allowed and does not count as an arm collision.",
        "Success is derived from independent native-MuJoCo ee_site measurements and contact events, never training reward or episode completion.",
        "Smoothness is an optimization preference represented by an action-rate cost; it is not an independent success condition.",
        "The displayed and held-out target sets use the same physical envelope but different deterministic generator seeds. They test interpolation and reset diversity, not out-of-distribution hardware robustness.",
        "A brief target crossing is a false positive for a proximity-only metric and must fail the five-tick sustained-arrival predicate."
      ],
      "forbidden_contacts": [
        "floor with link1 or link2",
        "base with link1 or link2"
      ]
    },
    "schema_version": 2
