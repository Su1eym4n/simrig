{
  "contract": {
    "behavior": {
      "objective": "Move ee_site to one world-frame target sampled around the robot and remain strictly within 0.05 m for five consecutive 0.02 s control ticks before the 200-tick horizon."
    },
    "compute": {
      "abort_rules": [],
      "gpu_hourly_cost": null,
      "max_gpu_hours": 2.0,
      "max_timesteps": 2000000,
      "max_wall_time_sec": 3600
    },
    "environment": {
      "backend": "mujoco-playground",
      "ref": "examples/mujoco_reach/orbit_reach.py"
    },
    "episode": {
      "horizon_steps": 200
    },
    "evaluation": {
      "evaluator": {
        "config": {
          "target_sets": {
            "displayed": {
              "case_seed_start": 0,
              "count": 30,
              "generator_seed": 0
            },
            "heldout": {
              "case_seed_start": 1000,
              "count": 30,
              "generator_seed": 9173
            }
          }
        },
        "plugin": "policy_evaluator.py"
      },
      "predicates": [
        {
          "event": "target_within_tolerance",
          "failure_category": "task_failure",
          "failure_code": "target_not_sustained",
          "hold_steps": 5,
          "id": "sustained_target_arrival",
          "type": "sustained"
        },
        {
          "body_a": "floor",
          "body_b": "link1",
          "failure_category": "forbidden_contact",
          "failure_code": "link1_floor_contact",
          "id": "no_floor_link1_contact",
          "max_count": 0,
          "type": "forbidden_contact"
        },
        {
          "body_a": "floor",
          "body_b": "link2",
          "failure_category": "forbidden_contact",
          "failure_code": "link2_floor_contact",
          "id": "no_floor_link2_contact",
          "max_count": 0,
          "type": "forbidden_contact"
        },
        {
          "body_a": "base",
          "body_b": "link1",
          "failure_category": "forbidden_contact",
          "failure_code": "link1_base_contact",
          "id": "no_base_link1_contact",
          "max_count": 0,
          "type": "forbidden_contact"
        },
        {
