          "failure_code": "link2_base_contact",
          "id": "no_base_link2_contact",
          "max_count": 0,
          "type": "forbidden_contact"
        },
        {
          "failure_category": "invalid_state",
          "failure_code": "mujoco_warning",
          "id": "no_mujoco_warnings",
          "metric": "mujoco_warning_count",
          "operator": "==",
          "type": "metric",
          "value": 0
        }
